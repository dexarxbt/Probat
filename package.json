{
  "name": "probat",
  "version": "1.0.0",
  "private": true,
  "description": "Turn README claims into Kane-verified proof receipts.",
  "type": "module",
  "bin": {
    "probat": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/integrity.test.ts",
    "validate": "npm run check && npm test && npm run build",
    "dev": "tsx src/cli.ts serve",
    "api": "tsx src/cli.ts serve",
    "start": "node dist/cli.js serve",
    "probat": "tsx src/cli.ts",
    "doctor": "tsx src/cli.ts doctor",
    "demo": "tsx src/demo-target.ts",
    "demo:target": "tsx src/demo-target.ts",
    "demo:target:built": "node dist/demo-target.js"
  },
  "dependencies": {
    "fastify": "5.12.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
